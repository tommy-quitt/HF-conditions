{
  "name": "hf-conditions",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "typecheck": "tsc --build --force && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "collect": "tsx scripts/collect.ts",
    "sync-data": "tsx scripts/sync-data.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "eslint": "^9.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.0"
  }
}
